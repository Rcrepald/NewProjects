# Token do bot, gerado no @BotFather do Telegram
TELEGRAM_TOKEN=

# Chave da API da Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# Códigos dos chats que podem usar o bot, separados por vírgula.
# Mande /start para o bot e ele mostra o seu código.
CHATS_AUTORIZADOS=

# Professoras da equipe e % de comissão sobre o que os alunos delas pagam.
# A dona (NOME_PROFESSORA) não entra aqui. Várias: Amanda:40,Bia:35
EQUIPE=Amanda:40

# Dados que aparecem na mensagem de cobrança
NOME_PROFESSORA=Ellen
NOME_ESTUDIO=Pilates da Ellen
CHAVE_PIX=

# Opcionais
# MODELO=claude-opus-5-5
# ESFORCO=low            # low | medium | high (mais alto = pensa mais, custa mais)
# WHISPER_MODELO=small   # tiny | base | small | medium (maior = transcreve melhor, mais lento)
# FUSO=America/Sao_Paulo
# BANCO=/caminho/para/pilates.db
